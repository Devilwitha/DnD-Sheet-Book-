<DMSpielScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        Label:
            text: "Gemeinsam spielen"
            font_size: '30sp'
            text_size: self.width, None
            halign: 'center'
            size_hint_y: None
            height: max(dp(56), self.texture_size[1] + dp(8))

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 10

                Button:
                    id: maps_btn
                    text: 'Kartenwerkstatt\nKarten unabhängig vorbereiten und wiederverwenden'
                    font_size: '18sp'
                    halign: 'center'
                    text_size: self.width - dp(24), None
                    size_hint_y: None
                    height: dp(80)
                    on_release: root.open_map_workshop()

                Button:
                    id: host_dm_btn
                    text: "Schnellstart als DM"
                    on_press: root.host_dm()
                    size_hint_y: None
                    height: dp(64)
                    font_size: '20sp'

                Button:
                    id: join_player_btn
                    text: "Spieler beitreten"
                    on_press: root.join_player()
                    size_hint_y: None
                    height: dp(64)
                    font_size: '20sp'

                Button:
                    id: prepare_dm_btn
                    text: "Kampagnen & Spielabende"
                    on_press: root.prepare_dm()
                    size_hint_y: None
                    height: dp(64)
                    font_size: '20sp'

                Button:
                    id: load_session_btn
                    text: "Sitzung laden"
                    on_press: root.load_session()
                    size_hint_y: None
                    height: dp(64)
                    font_size: '20sp'
                Button:
                    id: archive_btn
                    text: 'Sitzungsarchiv'
                    on_release: root.show_archive()
                    size_hint_y: None
                    height: dp(64)
                    font_size: '20sp'

        # Fixed footer: always reachable
        Button:
            text: "Zurück zum Hauptmenü"
            on_press: app.change_screen('main')
            size_hint_y: None
            height: dp(64)
            font_size: '20sp'
            text_size: self.width - dp(16), None
            halign: 'center'
            valign: 'middle'
