<PlayerLobbyScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

                Label:
                    text: 'Spieler Lobby'
                    font_size: '26sp'
                    size_hint_y: None
                    height: dp(56)

                Label:
                    id: selected_char_label
                    text: 'Kein Charakter ausgewählt'
                    size_hint_y: None
                    text_size: self.width, None
                    halign: 'center'
                    height: max(dp(48), self.texture_size[1] + dp(8))

                Button:
                    text: 'Charakter auswählen'
                    on_release: root.show_char_selection_popup()
                    size_hint: 1, None
                    height: dp(48)

                Button:
                    text: 'QR-Code mit Kamera scannen'
                    on_release: root.scan_join_qr()
                    size_hint_y: None
                    height: dp(52)
                Label:
                    text: "Verfügbare DMs:"
                    font_size: '18sp'
                    size_hint_y: None
                    height: dp(40)

                GridLayout:
                    id: dm_list
                    cols: 1
                    spacing: dp(6)
                    size_hint_y: None
                    height: max(self.minimum_height, dp(48))

                Label:
                    text: 'Oder manuell (IP:Port):'
                    size_hint_y: None
                    height: dp(40)

                TextInput:
                    id: manual_input
                    hint_text: '192.168.0.10:5555'
                    multiline: False
                    write_tab: False
                    size_hint: 1, None
                    height: dp(48)

                Label:
                    text: 'Beitrittscode vom DM (16 Zeichen):'
                    size_hint_y: None
                    height: dp(40)

                TextInput:
                    id: join_code_input
                    hint_text: 'z. B. A12B34C56D78E90F'
                    multiline: False
                    write_tab: False
                    input_type: 'text'
                    size_hint: 1, None
                    height: dp(48)

                Label:
                    id: status_label
                    text: ''
                    size_hint_y: None
                    text_size: self.width, None
                    halign: 'center'
                    height: max(dp(48), self.texture_size[1] + dp(8))

        Button:
            id: connect_button
            text: 'Verbinden'
            on_release: root.connect_to_dm()
            size_hint: 1, None
            height: dp(48)
            font_size: '18sp'

        Button:
            text: 'Zurück'
            on_release: app.go_back_screen()
            size_hint: 1, None
            height: dp(48)
            font_size: '18sp'
