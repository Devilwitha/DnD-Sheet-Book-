<DMLobbyScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

                Label:
                    id: lobby_title
                    text: 'DM Lobby'
                    font_size: '26sp'
                    size_hint_y: None
                    height: dp(56)

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)
                    Label:
                        text: 'Sitzung:'
                        size_hint_x: 0.3
                    TextInput:
                        id: session_name_input
                        text: 'DM Spiel'
                        multiline: False
                        write_tab: False
                    Button:
                        text: 'OK'
                        size_hint_x: 0.25
                        on_release: root.confirm_session_name()

                Label:
                    text: 'Adresse(n) (IP:Port):'
                    size_hint_y: None
                    height: dp(36)

                Label:
                    id: endpoint_label
                    text: ''
                    size_hint_y: None
                    text_size: self.width, None
                    halign: 'center'
                    height: max(dp(48), self.texture_size[1] + dp(8))

                Label:
                    text: 'Beitrittscode:'
                    size_hint_y: None
                    height: dp(36)

                Button:
                    text: 'QR-Code zum Beitreten anzeigen'
                    disabled: not root.host_ready
                    size_hint_y: None
                    height: dp(52)
                    on_release: root.show_join_qr()
                Button:
                    text: 'Verbindungshilfe / Windows-Freigabe'
                    size_hint_y: None
                    height: dp(52)
                    on_release: root.show_network_help()

                Label:
                    id: join_code_label
                    text: '-'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(56)

                Label:
                    text: 'Verbundene Spieler:'
                    font_size: '18sp'
                    size_hint_y: None
                    height: dp(40)

                GridLayout:
                    id: player_list
                    cols: 1
                    spacing: dp(4)
                    size_hint_y: None
                    height: max(self.minimum_height, dp(48))

                Label:
                    text: 'Sitzungs-Zusammenfassung:'
                    font_size: '18sp'
                    size_hint_y: None
                    height: dp(40)

                Label:
                    id: summary_label
                    text: ''
                    size_hint_y: None
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'top'
                    height: max(dp(48), self.texture_size[1] + dp(8))

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(48)

            Button:
                text: 'Spiel starten'
                disabled: not root.host_ready
                on_release: root.start_game()

            Button:
                text: 'Hintergrund'
                on_release: root.change_background()

            Button:
                text: 'Zurück'
                on_release: root.go_back()
