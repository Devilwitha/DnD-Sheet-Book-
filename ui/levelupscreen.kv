<LevelUpScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        Label:
            id: title_label
            font_size: '24sp'
            text_size: self.width, None
            halign: 'center'
            size_hint_y: None
            height: max(dp(50), self.texture_size[1] + dp(8))

        ScrollView:
            do_scroll_x: False
            GridLayout:
                id: level_up_layout
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: 10
            Button:
                id: confirm_button
                text: "Bestätigen"
                on_release: root.confirm_level_up()
            Button:
                text: "Abbrechen"
                on_press: root.cancel_level_up()
